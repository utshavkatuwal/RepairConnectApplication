APP_NAME=RepairConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---- Database (MySQL required locally per spec; sqlite fallback for CI) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=repairconnect
DB_USERNAME=root
DB_PASSWORD=
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
# BROADCAST_CONNECTION=reverb
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=127.0.0.1
# REVERB_PORT=8080

FILESYSTEM_DISK=local
# FILESYSTEM_DISK=azure (production only)

QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis (production / when Redis available)

CACHE_STORE=database
# CACHE_STORE=redis (production / when Redis available)

# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ---- Maps (configurable provider; keys stay server-side) ----
MAP_PROVIDER=carto
MAP_API_KEY=

# ---- Payments (sandbox or live creds; missing = clear 503, never fake) ----
ESEWA_MERCHANT_ID=
ESEWA_SECRET=
ESEWA_ENDPOINT=https://rc.esewa.com.np/epay/main
KHALTI_SECRET=
KHALTI_ENDPOINT=https://khalti.com/api/v2

# ---- Push (missing = stored without push + warning log) ----
FCM_SERVER_KEY=

# ---- Mail (log driver locally) ----
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@repairconnect.dev"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Azure (production only; local stays local) ----
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONTAINER=
